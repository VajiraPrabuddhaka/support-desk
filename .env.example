# Run `make env` to create .env from this file. It fills in every value
# marked "generated" and never overwrites an existing .env.

# OpenRouter. Required: set your key here.
OPENROUTER_API_KEY=
# Model for both agents. Any OpenRouter model with tool calling works.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Optional per-agent overrides.
TRIAGE_MODEL=
BILLING_MODEL=
# Cap on the tokens of one model reply. Without a cap, OpenRouter reserves
# credit for the model's full output limit and can refuse calls with 402.
MAX_OUTPUT_TOKENS=4096

# Gitea, the ticket system. The admin account is used only by the seed program.
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_EMAIL=gitea-admin@geogrid.example.com
# generated
GITEA_ADMIN_PASSWORD=
SUPPORT_REPO=geogrid/support

# Lago, the billing system. Sign in to the Lago UI with the admin email and
# password. LAGO_API_KEY is the organization's API key: lago-mcp, the console
# and the seed program use it.
LAGO_ADMIN_EMAIL=admin@geogrid.example.com
# generated
LAGO_ADMIN_PASSWORD=
# generated
LAGO_API_KEY=
# generated
LAGO_POSTGRES_PASSWORD=
# generated
LAGO_SECRET_KEY_BASE=
# generated
LAGO_ENCRYPTION_PRIMARY_KEY=
# generated
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
# generated
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
# generated: a 2048-bit RSA private key, base64-encoded
LAGO_RSA_PRIVATE_KEY=

# Host ports. Every port is bound to 127.0.0.1 only.
GITEA_PORT=3001
LAGO_API_PORT=3000
LAGO_UI_PORT=3080
CONSOLE_PORT=3030

# OpenChoreo only: the repository and branch that OpenChoreo builds the agents
# from. The build checks out what is on GitHub, so to build your own changes,
# push them to your fork and point these at it.
SOURCE_REPO=https://github.com/VajiraPrabuddhaka/support-desk
SOURCE_BRANCH=main
